#!/bin/sh
set -eu

runner=$1
model=$2

"@PYTHON3_EXECUTABLE@" - "$runner" "$model" <<'PY'
import struct
import subprocess
import sys

runner = sys.argv[1]
model = sys.argv[2]

prompt = b"Complete this sentence in four words: The sky is"
proc = subprocess.Popen(
    [
        runner,
        "--model",
        model,
        "--ctx",
        "1024",
        "--threads",
        "4",
        "--max-tokens",
        "8",
        "--temperature",
        "0",
    ],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
)

assert proc.stdin is not None
assert proc.stdout is not None

proc.stdin.write(struct.pack("<I", len(prompt)))
proc.stdin.write(prompt)
proc.stdin.flush()

chunks = []
while True:
    tag = proc.stdout.read(1)
    if tag == b"":
        raise SystemExit("runner closed stdout before done frame")
    if tag == b"\x01":
        size_bytes = proc.stdout.read(4)
        if len(size_bytes) != 4:
            raise SystemExit("truncated chunk length")
        size = struct.unpack("<I", size_bytes)[0]
        chunk = proc.stdout.read(size)
        if len(chunk) != size:
            raise SystemExit("truncated chunk payload")
        chunks.append(chunk)
        continue
    if tag == b"\x02":
        break
    if tag == b"\x03":
        size_bytes = proc.stdout.read(2)
        if len(size_bytes) != 2:
            raise SystemExit("truncated error length")
        size = struct.unpack("<H", size_bytes)[0]
        message = proc.stdout.read(size).decode("utf-8", errors="replace")
        raise SystemExit("runner error frame: " + message)
    raise SystemExit(f"unknown frame tag: {tag!r}")

proc.stdin.close()
stderr = proc.stderr.read().decode("utf-8", errors="replace")
status = proc.wait(timeout=10)
if status != 0:
    raise SystemExit(f"runner exited {status}: {stderr}")
if not b"".join(chunks).strip():
    raise SystemExit("runner produced empty output")
PY
