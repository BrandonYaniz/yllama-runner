#!/bin/sh
set -eu
runner=$1
model=$2
"@PYTHON3_EXECUTABLE@" - "$runner" "$model" <<'PY'
import struct, subprocess, sys
runner,model=sys.argv[1:]
def frame(t,p=b''): return bytes([t])+struct.pack('<I',len(p))+p
def generate(prompt,seed,max_tokens=8,temperature=0):
    b=prompt.encode();p=struct.pack('<BBHI',1,0,0,max_tokens)+struct.pack('<ddidddQ',temperature,1,0,0,0,1,seed)+struct.pack('<I',len(b))+b
    return frame(1,p)
def read(proc):
    h=proc.stdout.read(5)
    if len(h)!=5: raise SystemExit('unexpected EOF')
    t,n=struct.unpack('<BI',h);p=proc.stdout.read(n)
    if len(p)!=n: raise SystemExit('truncated frame')
    return t,p
p=subprocess.Popen([runner,'--protocol','2','--model',model,'--ctx','1024','--threads','4'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
t,_=read(p)
if t!=0x10: raise SystemExit('Ready not first')
outputs=[]
for seed,max_tokens,temperature in ((7,8,0),(7,8,0),(8,4,0.7)):
    p.stdin.write(generate('Complete briefly: The sky is',seed,max_tokens,temperature));p.stdin.flush();chunks=[];term=0
    while True:
        t,data=read(p)
        if t==1:
            n=struct.unpack_from('<I',data)[0];chunk=data[4:]
            if n!=len(chunk): raise SystemExit('bad chunk length')
            chunk.decode('utf-8');chunks.append(chunk)
        elif t==4:
            term+=1;reason,inp,out,pu,gu=struct.unpack('<BIIQQ',data)
            if inp<=0 or out<=0: raise SystemExit('bad usage')
            break
        elif t==3: raise SystemExit('runner Error '+repr(data))
    output=b''.join(chunks)
    if term!=1 or not output.strip(): raise SystemExit('bad completion')
    outputs.append(output)
if outputs[0]!=outputs[1]: raise SystemExit('same seed was not deterministic')
# Prove cancellation is observed after streaming starts and the model remains resident.
p.stdin.write(generate('Count upward forever: 1, 2, 3,',11,100000,0.7));p.stdin.flush()
cancel_sent=False
while True:
    t,data=read(p)
    if t==1:
        n=struct.unpack_from('<I',data)[0];data[4:].decode('utf-8')
        if n and not cancel_sent:
            p.stdin.write(frame(2));p.stdin.flush();cancel_sent=True
    elif t==4:
        reason=struct.unpack_from('<B',data)[0]
        if not cancel_sent or reason!=3: raise SystemExit('active cancellation failed')
        break
    elif t==3: raise SystemExit('cancellation Error '+repr(data))
p.stdin.write(generate('Reply with OK.',12,4,0));p.stdin.flush();after=[]
while True:
    t,data=read(p)
    if t==1: after.append(data[4:]);data[4:].decode('utf-8')
    elif t==4: break
    elif t==3: raise SystemExit('post-cancel Error '+repr(data))
if not b''.join(after): raise SystemExit('generation after cancellation was empty')
p.stdin.write(frame(3));p.stdin.flush();p.stdin.close()
stderr=p.stderr.read().decode(errors='replace')
if p.wait(timeout=10)!=0: raise SystemExit(stderr)
PY
